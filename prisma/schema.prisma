datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BookStatus {
  TO_READ
  READING
  PAUSED
  FINISHED
  ABANDONED
}

model Book {
  id                 Int         @id @default(autoincrement())
  googleBooksId      String?     @unique
  title              String
  authors            String
  coverUrl           String?
  coverPath          String?
  pageCount          Int?
  currentPage        Int?
  progressPercentage Int?
  isbn               String?
  status             BookStatus  @default(TO_READ)
  rating             Int?
  finishedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  notes              Note[]
  highlights         Highlight[]
}

enum NoteOrigin {
  MANUAL
  KINDLE
}

model Note {
  id            Int           @id @default(autoincrement())
  bookId        Int
  book          Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  content       String
  origin        NoteOrigin    @default(MANUAL)
  highlightId   Int?
  highlight     Highlight?    @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  pageStart     Int?
  pageEnd       Int?
  positionStart Int?
  positionEnd   Int?
  capturedAt    DateTime?
  fingerprint   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([bookId, fingerprint])
  @@index([highlightId])
}

model Highlight {
  id            Int          @id @default(autoincrement())
  bookId        Int
  book          Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  content       String
  pageStart     Int?
  pageEnd       Int?
  positionStart Int?
  positionEnd   Int?
  capturedAt    DateTime?
  fingerprint   String
  color         HighlightColor?
  createdAt     DateTime     @default(now())
  notes         Note[]

  @@unique([bookId, fingerprint])
}

enum HighlightColor {
  YELLOW
  BLUE
  PINK
  ORANGE
}

model ImportedNotebookFile {
  id         Int      @id @default(autoincrement())
  path       String   @unique
  modifiedAt DateTime
  importedAt DateTime @default(now())
}
